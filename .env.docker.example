# Copy to .env in the repository root for production deploy:
#   cp .env.docker.example .env
#
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

MODERATOR_EMAIL=moderator@example.com
MODERATOR_PASSWORD=change-me-before-deploy

# Set to true only on first deploy (or when you need to re-seed).
RUN_SEED=false
